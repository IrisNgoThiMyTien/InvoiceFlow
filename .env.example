# --- InvoiceFlow: bien moi truong (sao chep file nay thanh .env va dien gia tri) ---

# Che do OCR: hien tai chi ho tro "mock" (demo mode, khong goi API that)
# OCR_PROVIDER=groq se duoc kich hoat o buoc tiep theo, chua dung duoc trong buoc nay.
OCR_PROVIDER=mock

# API key cho Groq (vision LLM OCR) - de trong o day, KHONG hard-code gia tri
# that vao code hay commit gia tri that len git. Chi dien vao file .env cuc bo.
GROQ_API_KEY=
# Kiem tra danh sach model vision con hieu luc tai: https://console.groq.com/docs/models
GROQ_MODEL=qwen/qwen3.6-27b

# Thu muc luu anh hoa don goc
UPLOAD_DIR=uploads

# Duong dan file SQLite
DB_PATH=data/invoiceflow.db

# Kich thuoc file toi da cho phep upload (MB)
MAX_UPLOAD_SIZE_MB=10
